  <maintainer email="maintainers@example.com">MUR maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>python3-dev</build_depend>
  <depend>pybind11_vendor</depend><depend>rclcpp</depend>
  <depend>moveit_core</depend><depend>moveit_ros_planning</depend><depend>yaml-cpp</depend>
