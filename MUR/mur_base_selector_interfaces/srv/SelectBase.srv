# TCP goal. Orientation is required; use a unit quaternion.
geometry_msgs/PoseStamped target
# Empty: configured default; either: any arm; or a configured name. both: intersection.
string arm
---
bool success
string message
uint64 request_id
# Only valid on success. Selection only; never starts navigation.
geometry_msgs/PoseStamped navigation_goal
string arm
string[] planning_groups
string[] tcp_frames
float64 score
float64 valid_for_seconds
string diagnostics_json
