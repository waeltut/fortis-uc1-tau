<?xml version="1.0"?>
<package format="3">
  <name>dual_arm_commander</name><version>1.0.0</version>
  <description>Single-goal action-only arm motion coordinator for MoveIt.</description>
  <maintainer email="hugo.minkkinen@tuni.fi">fortis_dev</maintainer>
  <license>TODO: License declaration</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
