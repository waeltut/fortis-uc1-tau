    <origin rpy="3.14159265359 -1.570796 0" xyz="0.055 0 0.02"/>
  </joint>
  <link name="left_camera_link"/>
  <joint name="left_camera_to_camera_link" type="fixed">
    <parent link="left_camera"/>
    <child link="left_camera_link"/>
    <origin rpy="0 0 0" xyz="0.025 0.0475 0"/>
